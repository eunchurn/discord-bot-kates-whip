# Discord bot token (required)
DISCORD_TOKEN=<discord_token>

# SQLite database. Also read by the Prisma CLI (migrate / studio).
DATABASE_URL=file:./data/kates-whip.db

# Scheduler tick interval in seconds (how often reminders are evaluated)
TICK_SECONDS=30

# Default IANA timezone used when a guild has not set one.
# Kingshot server time is UTC, so keep this as UTC unless you have a reason not to.
DEFAULT_TIMEZONE=UTC

# Default reminder lead times in minutes, comma separated
DEFAULT_LEAD_MINUTES=10,5
